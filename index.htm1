    nav a {
      color: #1e3a8a;
      text-decoration: none;
      margin: 0 12px;
      font-weight: bold;
    }

    main {
      max-width: 1000px;
      margin: 35px auto;
      padding: 0 20px;
    }

    section {
      background: white;
      margin-bottom: 25px;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 4px 18px rgba(0,0,0,.07);
    }

    h2 {
      color: #1e3a8a;
      border-bottom: 2px solid #e5e7eb;
      padding-bottom: 10px;
    }

    .item {
      margin: 18px 0;
      padding-right: 15px;
      border-right: 4px solid #2563eb;
    }

    .highlight {
      font-weight: bold;
      color: #111827;
    }

    ul {
      padding-right: 22px;
    }

    footer {
      background: #172554;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 40px;
    }

    @media (max-width: 600px) {
      header h1 { font-size: 28px; }
      header p { font-size: 16px; }
      section { padding: 20px; }
      nav a { display: inline-block; margin: 5px; }
