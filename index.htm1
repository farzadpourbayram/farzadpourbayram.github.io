  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Tahoma, Arial, sans-serif;
      background: #f4f6f8;
      color: #1f2937;
      line-height: 1.9;
    }

    header {
      background: linear-gradient(135deg, #172554, #1e3a8a);
      color: white;
      padding: 60px 20px;
      text-align: center;
    }

    header h1 {
      margin: 0 0 10px;
      font-size: 38px;
    }

